      {
        "category": "antibiotic",
        "name_cn": "左氧氟沙星",
        "name_en": "Levofloxacin",
        "dosage": "500mg",
        "frequency": "qd",
        "role": "二线方案用药"
      }
    ]
  },
  "maintenance_therapy": {
